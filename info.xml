<?xml version="1.0"?>
<extension key="org.civicrm.googlegroups" type="module">
  <file>googlegroups</file>
  <name>Google Groups Integration</name>
  <description>CiviCRM and Google Groups Integration</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Deepak Srivastava</author>
    <email>deepak@mountev.co.uk</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/greenleafadvancement/org.civicrm.googlegroups</url>
    <url desc="Documentation">https://github.com/greenleafadvancement/org.civicrm.googlegroups/blob/master/README.md</url>
    <url desc="Support">https://greenleafadvancement.com/</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2024-02-23</releaseDate>
  <version>2.4</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.38</ver>
  </compatibility>
  <comments>
    Original extension (uk.co.vedaconsulting.googlegroup) development by Veda NFP Consulting Ltd (https://vedaconsulting.co.uk/) supporting CiviCRM versions upto v4.6.
    Rewrite for CiviCRM v5.x funded by Greenleaf Advancement (https://greenleafadvancement.com) and Joshua Gowans (https://civicrm.org), developed by Deepak Srivastava (https://mountev.co.uk).
  </comments>
  <civix>
    <namespace>CRM/Googlegroups</namespace>
    <format>25.01.1</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Googlegroups\AutomaticUpgrader</upgrader>
</extension>
